# Copiar este archivo a ".env" y completar los valores.

# PostgreSQL (usuario, contraseña y base de datos propios)
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db
# Para desarrollo local con SQLite, usar en cambio:
# DATABASE_URL=sqlite:///./foodstore.db

# Clave para firmar el JWT: mínimo 32 caracteres
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173
